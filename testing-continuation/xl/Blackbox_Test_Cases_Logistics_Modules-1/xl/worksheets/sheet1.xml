<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><sheetPr><outlinePr summaryBelow="1" summaryRight="1"/><pageSetUpPr/></sheetPr><dimension ref="A1:G42"/><sheetViews><sheetView workbookViewId="0"><selection activeCell="A1" sqref="A1"/></sheetView></sheetViews><sheetFormatPr baseColWidth="8" defaultRowHeight="15"/><cols><col width="36" customWidth="1" min="1" max="1"/><col width="34" customWidth="1" min="2" max="2"/><col width="10" customWidth="1" min="3" max="3"/><col width="10" customWidth="1" min="4" max="4"/><col width="10" customWidth="1" min="5" max="5"/><col width="10" customWidth="1" min="6" max="6"/><col width="22" customWidth="1" min="7" max="7"/></cols><sheetData><row r="1"><c r="A1" s="1" t="inlineStr"><is><t>Black-Box Test Cases: Logistics Modules (L1&#8211;L8)</t></is></c></row><row r="2"><c r="A2" s="2" t="inlineStr"><is><t>Multi-role e-commerce and logistics platform (Buyer, Seller, Logistics, Rider)</t></is></c></row><row r="4"><c r="A4" s="3" t="inlineStr"><is><t>Test run details</t></is></c></row><row r="5"><c r="A5" s="4" t="inlineStr"><is><t>System under test</t></is></c><c r="B5" s="5" t="n"></c></row><row r="6"><c r="A6" s="4" t="inlineStr"><is><t>Version / build</t></is></c><c r="B6" s="5" t="n"></c></row><row r="7"><c r="A7" s="4" t="inlineStr"><is><t>Test environment (browser, device)</t></is></c><c r="B7" s="5" t="n"></c></row><row r="8"><c r="A8" s="4" t="inlineStr"><is><t>Tester</t></is></c><c r="B8" s="5" t="n"></c></row><row r="9"><c r="A9" s="4" t="inlineStr"><is><t>Date tested</t></is></c><c r="B9" s="5" t="n"></c></row><row r="11"><c r="A11" s="3" t="inlineStr"><is><t>Results by module</t></is></c></row><row r="12"><c r="A12" s="6" t="inlineStr"><is><t>Module (sheet)</t></is></c><c r="B12" s="6" t="inlineStr"><is><t>Total test cases</t></is></c><c r="C12" s="6" t="inlineStr"><is><t>Pass</t></is></c><c r="D12" s="6" t="inlineStr"><is><t>Fail</t></is></c><c r="E12" s="6" t="inlineStr"><is><t>Blocked</t></is></c><c r="F12" s="6" t="inlineStr"><is><t>Not Run</t></is></c><c r="G12" s="6" t="inlineStr"><is><t>Pass rate (Pass / Total)</t></is></c></row><row r="13"><c r="A13" s="7" t="inlineStr"><is><t>L1 Dashboard</t></is></c><c r="B13" s="8"><f>COUNTA('L1 Dashboard'!$A$2:$A$200)</f><v></v></c><c r="C13" s="8"><f>COUNTIF('L1 Dashboard'!$L$2:$L$200,"Pass")</f><v></v></c><c r="D13" s="8"><f>COUNTIF('L1 Dashboard'!$L$2:$L$200,"Fail")</f><v></v></c><c r="E13" s="8"><f>COUNTIF('L1 Dashboard'!$L$2:$L$200,"Blocked")</f><v></v></c><c r="F13" s="8"><f>COUNTIF('L1 Dashboard'!$L$2:$L$200,"Not Run")</f><v></v></c><c r="G13" s="9"><f>IF(B13=0,0,C13/B13)</f><v></v></c></row><row r="14"><c r="A14" s="7" t="inlineStr"><is><t>L2 Rider Mgmt</t></is></c><c r="B14" s="8"><f>COUNTA('L2 Rider Mgmt'!$A$2:$A$200)</f><v></v></c><c r="C14" s="8"><f>COUNTIF('L2 Rider Mgmt'!$L$2:$L$200,"Pass")</f><v></v></c><c r="D14" s="8"><f>COUNTIF('L2 Rider Mgmt'!$L$2:$L$200,"Fail")</f><v></v></c><c r="E14" s="8"><f>COUNTIF('L2 Rider Mgmt'!$L$2:$L$200,"Blocked")</f><v></v></c><c r="F14" s="8"><f>COUNTIF('L2 Rider Mgmt'!$L$2:$L$200,"Not Run")</f><v></v></c><c r="G14" s="9"><f>IF(B14=0,0,C14/B14)</f><v></v></c></row><row r="15"><c r="A15" s="7" t="inlineStr"><is><t>L3 Dispatch</t></is></c><c r="B15" s="8"><f>COUNTA('L3 Dispatch'!$A$2:$A$200)</f><v></v></c><c r="C15" s="8"><f>COUNTIF('L3 Dispatch'!$L$2:$L$200,"Pass")</f><v></v></c><c r="D15" s="8"><f>COUNTIF('L3 Dispatch'!$L$2:$L$200,"Fail")</f><v></v></c><c r="E15" s="8"><f>COUNTIF('L3 Dispatch'!$L$2:$L$200,"Blocked")</f><v></v></c><c r="F15" s="8"><f>COUNTIF('L3 Dispatch'!$L$2:$L$200,"Not Run")</f><v></v></c><c r="G15" s="9"><f>IF(B15=0,0,C15/B15)</f><v></v></c></row><row r="16"><c r="A16" s="7" t="inlineStr"><is><t>L4 Hub Ops</t></is></c><c r="B16" s="8"><f>COUNTA('L4 Hub Ops'!$A$2:$A$200)</f><v></v></c><c r="C16" s="8"><f>COUNTIF('L4 Hub Ops'!$L$2:$L$200,"Pass")</f><v></v></c><c r="D16" s="8"><f>COUNTIF('L4 Hub Ops'!$L$2:$L$200,"Fail")</f><v></v></c><c r="E16" s="8"><f>COUNTIF('L4 Hub Ops'!$L$2:$L$200,"Blocked")</f><v></v></c><c r="F16" s="8"><f>COUNTIF('L4 Hub Ops'!$L$2:$L$200,"Not Run")</f><v></v></c><c r="G16" s="9"><f>IF(B16=0,0,C16/B16)</f><v></v></c></row><row r="17"><c r="A17" s="7" t="inlineStr"><is><t>L5 Tracking &amp; Exceptions</t></is></c><c r="B17" s="8"><f>COUNTA('L5 Tracking &amp; Exceptions'!$A$2:$A$200)</f><v></v></c><c r="C17" s="8"><f>COUNTIF('L5 Tracking &amp; Exceptions'!$L$2:$L$200,"Pass")</f><v></v></c><c r="D17" s="8"><f>COUNTIF('L5 Tracking &amp; Exceptions'!$L$2:$L$200,"Fail")</f><v></v></c><c r="E17" s="8"><f>COUNTIF('L5 Tracking &amp; Exceptions'!$L$2:$L$200,"Blocked")</f><v></v></c><c r="F17" s="8"><f>COUNTIF('L5 Tracking &amp; Exceptions'!$L$2:$L$200,"Not Run")</f><v></v></c><c r="G17" s="9"><f>IF(B17=0,0,C17/B17)</f><v></v></c></row><row r="18"><c r="A18" s="7" t="inlineStr"><is><t>L6 Returns (RTS)</t></is></c><c r="B18" s="8"><f>COUNTA('L6 Returns (RTS)'!$A$2:$A$200)</f><v></v></c><c r="C18" s="8"><f>COUNTIF('L6 Returns (RTS)'!$L$2:$L$200,"Pass")</f><v></v></c><c r="D18" s="8"><f>COUNTIF('L6 Returns (RTS)'!$L$2:$L$200,"Fail")</f><v></v></c><c r="E18" s="8"><f>COUNTIF('L6 Returns (RTS)'!$L$2:$L$200,"Blocked")</f><v></v></c><c r="F18" s="8"><f>COUNTIF('L6 Returns (RTS)'!$L$2:$L$200,"Not Run")</f><v></v></c><c r="G18" s="9"><f>IF(B18=0,0,C18/B18)</f><v></v></c></row><row r="19"><c r="A19" s="7" t="inlineStr"><is><t>L7 Zones &amp; Rates</t></is></c><c r="B19" s="8"><f>COUNTA('L7 Zones &amp; Rates'!$A$2:$A$200)</f><v></v></c><c r="C19" s="8"><f>COUNTIF('L7 Zones &amp; Rates'!$L$2:$L$200,"Pass")</f><v></v></c><c r="D19" s="8"><f>COUNTIF('L7 Zones &amp; Rates'!$L$2:$L$200,"Fail")</f><v></v></c><c r="E19" s="8"><f>COUNTIF('L7 Zones &amp; Rates'!$L$2:$L$200,"Blocked")</f><v></v></c><c r="F19" s="8"><f>COUNTIF('L7 Zones &amp; Rates'!$L$2:$L$200,"Not Run")</f><v></v></c><c r="G19" s="9"><f>IF(B19=0,0,C19/B19)</f><v></v></c></row><row r="20"><c r="A20" s="7" t="inlineStr"><is><t>L8 COD &amp; Reports</t></is></c><c r="B20" s="8"><f>COUNTA('L8 COD &amp; Reports'!$A$2:$A$200)</f><v></v></c><c r="C20" s="8"><f>COUNTIF('L8 COD &amp; Reports'!$L$2:$L$200,"Pass")</f><v></v></c><c r="D20" s="8"><f>COUNTIF('L8 COD &amp; Reports'!$L$2:$L$200,"Fail")</f><v></v></c><c r="E20" s="8"><f>COUNTIF('L8 COD &amp; Reports'!$L$2:$L$200,"Blocked")</f><v></v></c><c r="F20" s="8"><f>COUNTIF('L8 COD &amp; Reports'!$L$2:$L$200,"Not Run")</f><v></v></c><c r="G20" s="9"><f>IF(B20=0,0,C20/B20)</f><v></v></c></row><row r="21"><c r="A21" s="4" t="inlineStr"><is><t>Total</t></is></c><c r="B21" s="4"><f>SUM(B13:B20)</f><v></v></c><c r="C21" s="4"><f>SUM(C13:C20)</f><v></v></c><c r="D21" s="4"><f>SUM(D13:D20)</f><v></v></c><c r="E21" s="4"><f>SUM(E13:E20)</f><v></v></c><c r="F21" s="4"><f>SUM(F13:F20)</f><v></v></c><c r="G21" s="10"><f>IF(B21=0,0,C21/B21)</f><v></v></c></row><row r="23"><c r="A23" s="3" t="inlineStr"><is><t>How to use this workbook</t></is></c></row><row r="24" ht="16.75" customHeight="1"><c r="A24" s="11" t="inlineStr"><is><t>1. Logistics cases need parcels from the Seller and Buyer test sets and riders from the Account Creation set.</t></is></c></row><row r="25" ht="29.5" customHeight="1"><c r="A25" s="11" t="inlineStr"><is><t>2. Strict pass rule: a case passes only if EVERY point in its Expected Result is true. If any point is false, or something happens that the Expected Result does not mention (an extra record, a stock change, a wrong notification, a console error, a 500 page), mark it Fail.</t></is></c></row><row r="26" ht="29.5" customHeight="1"><c r="A26" s="11" t="inlineStr"><is><t>3. Check side effects, not just the screen: after each case, confirm the stock, order status, voucher usage, balances and the other roles' views named in the Expected Result. 'Nothing is saved' means the record is missing after a page refresh.</t></is></c></row><row r="27" ht="29.5" customHeight="1"><c r="A27" s="11" t="inlineStr"><is><t>4. Error messages must appear next to the field (or at the top of the form) and say what is wrong and how to fix it. A generic 'Something went wrong', a blank page, or a 500 error is a Fail even when the action was correctly blocked.</t></is></c></row><row r="28" ht="29.5" customHeight="1"><c r="A28" s="11" t="inlineStr"><is><t>5. For 'Error Guessing' security cases, a correct block shows a 403 page, a 'not found' page or a redirect, and shows NO data from the other user's record anywhere on the page.</t></is></c></row><row r="29" ht="29.5" customHeight="1"><c r="A29" s="11" t="inlineStr"><is><t>6. Read the Assumptions sheet first. Rules A2 to A8 are the seven rules the module plan says must be agreed before testing; adjust any case whose rule differs from your system.</t></is></c></row><row r="30" ht="29.5" customHeight="1"><c r="A30" s="11" t="inlineStr"><is><t>7. Seed the accounts, products, vouchers and shipping rates on the Test Data sheet before running the cases. Emails use example.com; read them from a mail catcher such as Mailtrap.</t></is></c></row><row r="31" ht="16.75" customHeight="1"><c r="A31" s="11" t="inlineStr"><is><t>8. Test Case IDs follow &lt;ROLE&gt;-&lt;MODULE&gt;-&lt;NNN&gt;. Each module has positive, negative and boundary cases.</t></is></c></row><row r="32" ht="16.75" customHeight="1"><c r="A32" s="11" t="inlineStr"><is><t>9. Fill in only the yellow cells: Actual Result, Status and Remarks. Pick the Status from the dropdown (Pass, Fail, Blocked, Not Run).</t></is></c></row><row r="33" ht="29.5" customHeight="1"><c r="A33" s="11" t="inlineStr"><is><t>10. Pass = actual matches expected. Fail = it does not (describe what happened and add a screenshot or bug number in Remarks). Blocked = the case could not be run, for example because an earlier case failed.</t></is></c></row><row r="34" ht="16.75" customHeight="1"><c r="A34" s="11" t="inlineStr"><is><t>11. The Results by module table above updates automatically from the Status column.</t></is></c></row><row r="36"><c r="A36" s="3" t="inlineStr"><is><t>Black-box techniques used</t></is></c></row><row r="37"><c r="A37" s="4" t="inlineStr"><is><t>Equivalence Partitioning</t></is></c><c r="B37" s="8" t="inlineStr"><is><t>Inputs are grouped into valid and invalid classes, and one value from each class is tested.</t></is></c><c r="C37" s="12" t="n"></c><c r="D37" s="12" t="n"></c><c r="E37" s="12" t="n"></c><c r="F37" s="12" t="n"></c><c r="G37" s="13" t="n"></c></row><row r="38"><c r="A38" s="4" t="inlineStr"><is><t>Boundary Value Analysis</t></is></c><c r="B38" s="8" t="inlineStr"><is><t>Values at and just beyond a limit are tested, for example &#8369;0.99, &#8369;1.00 and &#8369;1.01 for a &#8369;1.00 minimum price.</t></is></c><c r="C38" s="12" t="n"></c><c r="D38" s="12" t="n"></c><c r="E38" s="12" t="n"></c><c r="F38" s="12" t="n"></c><c r="G38" s="13" t="n"></c></row><row r="39"><c r="A39" s="4" t="inlineStr"><is><t>Decision Table</t></is></c><c r="B39" s="8" t="inlineStr"><is><t>Combinations of conditions are tested, for example which vouchers can stack.</t></is></c><c r="C39" s="12" t="n"></c><c r="D39" s="12" t="n"></c><c r="E39" s="12" t="n"></c><c r="F39" s="12" t="n"></c><c r="G39" s="13" t="n"></c></row><row r="40"><c r="A40" s="4" t="inlineStr"><is><t>State Transition</t></is></c><c r="B40" s="8" t="inlineStr"><is><t>Changes in order or shipment status are tested, including transitions that must be blocked.</t></is></c><c r="C40" s="12" t="n"></c><c r="D40" s="12" t="n"></c><c r="E40" s="12" t="n"></c><c r="F40" s="12" t="n"></c><c r="G40" s="13" t="n"></c></row><row r="41"><c r="A41" s="4" t="inlineStr"><is><t>Use Case Testing</t></is></c><c r="B41" s="8" t="inlineStr"><is><t>A complete user flow is tested from start to finish with valid data.</t></is></c><c r="C41" s="12" t="n"></c><c r="D41" s="12" t="n"></c><c r="E41" s="12" t="n"></c><c r="F41" s="12" t="n"></c><c r="G41" s="13" t="n"></c></row><row r="42"><c r="A42" s="4" t="inlineStr"><is><t>Error Guessing</t></is></c><c r="B42" s="8" t="inlineStr"><is><t>Likely mistakes are tested based on experience, for example double-clicking Place Order or editing an ID in the URL.</t></is></c><c r="C42" s="12" t="n"></c><c r="D42" s="12" t="n"></c><c r="E42" s="12" t="n"></c><c r="F42" s="12" t="n"></c><c r="G42" s="13" t="n"></c></row></sheetData><mergeCells count="17"><mergeCell ref="A32:G32"/><mergeCell ref="B38:G38"/><mergeCell ref="B42:G42"/><mergeCell ref="A27:G27"/><mergeCell ref="A31:G31"/><mergeCell ref="B37:G37"/><mergeCell ref="A34:G34"/><mergeCell ref="B41:G41"/><mergeCell ref="A26:G26"/><mergeCell ref="A24:G24"/><mergeCell ref="A30:G30"/><mergeCell ref="B40:G40"/><mergeCell ref="A29:G29"/><mergeCell ref="A25:G25"/><mergeCell ref="A33:G33"/><mergeCell ref="B39:G39"/><mergeCell ref="A28:G28"/></mergeCells><pageMargins left="0.75" right="0.75" top="1" bottom="1" header="0.5" footer="0.5"/></worksheet>