8 Checkout'!$A$2:$A$200)</f><v></v></c><c r="C20" s="8"><f>COUNTIF('B8 Checkout'!$L$2:$L$200,"Pass")</f><v></v></c><c r="D20" s="8"><f>COUNTIF('B8 Checkout'!$L$2:$L$200,"Fail")</f><v></v></c><c r="E20" s="8"><f>COUNTIF('B8 Checkout'!$L$2:$L$200,"Blocked")</f><v></v></c><c r="F20" s="8"><f>COUNTIF('B8 Checkout'!$L$2:$L$200,"Not Run")</f><v></v></c><c r="G20" s="9"><f>IF(B20=0,0,C20/B20)</f><v></v></c></row><row r="21"><c r="A21" s="7" t="inlineStr"><is><t>B9 Payment</t></is></c><c r="B21" s="8"><f>COUNTA('B9 Payment'!$A$2:$A$200)</f><v></v></c><c r="C21" s="8"><f>COUNTIF('B9 Payment'!$L$2:$L$200,"Pass")</f><v></v></c><c r="D21" s="8"><f>COUNTIF('B9 Payment'!$L$2:$L$200,"Fail")</f><v></v></c><c r="E21" s="8"><f>COUNTIF('B9 Payment'!$L$2:$L$200,"Blocked")</f><v></v></c><c r="F21" s="8"><f>COUNTIF('B9 Payment'!$L$2:$L$200,"Not Run")</f><v></v></c><c r="G21" s="9"><f>IF(B21=0,0,C21/B21)</f><v></v></c></row><row r="22"><c r="A22" s="7" t="inlineStr"><is><t>B10 Order Tracking</t></is></c><c r="B22" s="8"><f>COUNTA('B10 Order Tracking'!$A$2:$A$200)</f><v></v></c><c r="C22" s="8"><f>COUNTIF('B10 Order Tracking'!$L$2:$L$200,"Pass")</f><v></v></c><c r="D22" s="8"><f>COUNTIF('B10 Order Tracking'!$L$2:$L$200,"Fail")</f><v></v></c><c r="E22" s="8"><f>COUNTIF('B10 Order Tracking'!$L$2:$L$200,"Blocked")</f><v></v></c><c r="F22" s="8"><f>COUNTIF('B10 Order Tracking'!$L$2:$L$200,"Not Run")</f><v></v></c><c r="G22" s="9"><f>IF(B22=0,0,C22/B22)</f><v></v></c></row><row r="23"><c r="A23" s="7" t="inlineStr"><is><t>B11 Cancellation</t></is></c><c r="B23" s="8"><f>COUNTA('B11 Cancellation'!$A$2:$A$200)</f><v></v></c><c r="C23" s="8"><f>COUNTIF('B11 Cancellation'!$L$2:$L$200,"Pass")</f><v></v></c><c r="D23" s="8"><f>COUNTIF('B11 Cancellation'!$L$2:$L$200,"Fail")</f><v></v></c><c r="E23" s="8"><f>COUNTIF('B11 Cancellation'!$L$2:$L$200,"Blocked")</f><v></v></c><c r="F23" s="8"><f>COUNTIF('B11 Cancellation'!$L$2:$L$200,"Not Run")</f><v></v></c><c r="G23" s="9"><f>IF(B23=0,0,C23/B23)</f><v></v></c></row><row r="24"><c r="A24" s="7" t="inlineStr"><is><t>B12 Return &amp; Refund</t></is></c><c r="B24" s="8"><f>COUNTA('B12 Return &amp; Refund'!$A$2:$A$200)</f><v></v></c><c r="C24" s="8"><f>COUNTIF('B12 Return &amp; Refund'!$L$2:$L$200,"Pass")</f><v></v></c><c r="D24" s="8"><f>COUNTIF('B12 Return &amp; Refund'!$L$2:$L$200,"Fail")</f><v></v></c><c r="E24" s="8"><f>COUNTIF('B12 Return &amp; Refund'!$L$2:$L$200,"Blocked")</f><v></v></c><c r="F24" s="8"><f>COUNTIF('B12 Return &amp; Refund'!$L$2:$L$200,"Not Run")</f><v></v></c><c r="G24" s="9"><f>IF(B24=0,0,C24/B24)</f><v></v></c></row><row r="25"><c r="A25" s="7" t="inlineStr"><is><t>B13 Ratings &amp; Reviews</t></is></c><c r="B25" s="8"><f>COUNTA('B13 Ratings &amp; Reviews'!$A$2:$A$200)</f><v></v></c><c r="C25" s="8"><f>COUNTIF('B13 Ratings &amp; Reviews'!$L$2:$L$200,"Pass")</f><v></v></c><c r="D25" s="8"><f>COUNTIF('B13 Ratings &amp; Reviews'!$L$2:$L$200,"Fail")</f><v></v></c><c r="E25" s="8"><f>COUNTIF('B13 Ratings &amp; Reviews'!$L$2:$L$200,"Blocked")</f><v></v></c><c r="F25" s="8"><f>COUNTIF('B13 Ratings &amp; Reviews'!$L$2:$L$200,"Not Run")</f><v></v></c><c r="G25" s="9"><f>IF(B25=0,0,C25/B25)</f><v></v></c></row><row r="26"><c r="A26" s="7" t="inlineStr"><is><t>B14 Chat &amp; Notifs</t></is></c><c r="B26" s="8"><f>COUNTA('B14 Chat &amp; Notifs'!$A$2:$A$200)</f><v></v></c><c r="C26" s="8"><f>COUNTIF('B14 Chat &amp; Notifs'!$L$2:$L$200,"Pass")</f><v></v></c><c r="D26" s="8"><f>COUNTIF('B14 Chat &amp; Notifs'!$L$2:$L$200,"Fail")</f><v></v></c><c r="E26" s="8"><f>COUNTIF('B14 Chat &amp; Notifs'!$L$2:$L$200,"Blocked")</f><v></v></c><c r="F26" s="8"><f>COUNTIF('B14 Chat &amp; Notifs'!$L$2:$L$200,"Not Run")</f><v></v></c><c r="G26" s="9"><f>IF(B26=0,0,C26/B26)</f><v></v></c></row><row r="27"><c r="A27" s="4" t="inlineStr"><is><t>Total</t></is></c><c r="B27" s="4"><f>SUM(B13:B26)</f><v></v></c><c r="C27" s="4"><f>SUM(C13:C26)</f><v></v></c><c r="D27" s="4"><f>SUM(D13:D26)</f><v></v></c><c r="E27" s="4"><f>SUM(E13:E26)</f><v></v></c><c r="F27" s="4"><f>SUM(F13:F26)</f><v></v></c><c r="G27" s="10"><f>IF(B27=0,0,C27/B27)</f><v></v></c></row><row r="29"><c r="A29" s="3" t="inlineStr"><is><t>How to use this workbook</t></is></c></row><row r="30" ht="16.75" customHeight="1"><c r="A30" s="11" t="inlineStr"><is><t>1. Run after the Seller test set, so the products, vouchers and sales on the Test Data sheet exist.</t></is></c></row><row r="31" ht="29.5" customHeight="1"><c r="A31" s="11" t="inlineStr"><is><t>2. Strict pass rule: a case passes only if EVERY point in its Expected Result is true. If any point is false, or something happens that the Expected Result does not mention (an extra record, a stock change, a wrong notification, a console error, a 500 page), mark it Fail.</t></is></c></row><row r="32" ht="29.5" customHeight="1"><c r="A32" s="11" t="inlineStr"><is><t>3. Check side effects, not just the screen: after each case, confirm the stock, order status, voucher usage, balances and the other roles' views named in the Expected Result. 'Nothing is saved' means the record is missing after a page refresh.</t></is></c></row><row r="33" ht="29.5" customHeight="1"><c r="A33" s="11" t="inlineStr"><is><t>4. Error messages must appear next to the field (or at the top of the form) and say what is wrong and how to fix it. A generic 'Something went wrong', a blank page, or a 500 error is a Fail even when the action was correctly blocked.</t></is></c></row><row r="34" ht="29.5" customHeight="1"><c r="A34" s="11" t="inlineStr"><is><t>5. For 'Error Guessing' security cases, a correct block shows a 403 page, a 'not found' page or a redirect, and shows NO data from the other user's record anywhere on the page.</t></is></c></row><row r="35" ht="29.5" customHeight="1"><c r="A35" s="11" t="inlineStr"><is><t>6. Read the Assumptions sheet first. Rules A2 to A8 are the seven rules the module plan says must be agreed before testing; adjust any case whose rule differs from your system.</t></is></c></row><row r="36" ht="29.5" customHeight="1"><c r="A36" s="11" t="inlineStr"><is><t>7. Seed the accounts, products, vouchers and shipping rates on the Test Data sheet before running the cases. Emails use example.com; read them from a mail catcher such as Mailtrap.</t></is></c></row><row r="37" ht="16.75" customHeight="1"><c r="A37" s="11" t="inlineStr"><is><t>8. Test Case IDs follow &lt;ROLE&gt;-&lt;MODULE&gt;-&lt;NNN&gt;. Each module has positive, negative and boundary cases.</t></is></c></row><row r="38" ht="16.75" customHeight="1"><c r="A38" s="11" t="inlineStr"><is><t>9. Fill in only the yellow cells: Actual Result, Status and Remarks. Pick the Status from the dropdown (Pass, Fail, Blocked, Not Run).</t></is></c></row><row r="39" ht="29.5" customHeight="1"><c r="A39" s="11" t="inlineStr"><is><t>10. Pass = actual matches expected. Fail = it does not (describe what happened and add a screenshot or bug number in Remarks). Blocked = the case could not be run, for example because an earlier case failed.</t></is></c></row><row r="40" ht="16.75" customHeight="1"><c r="A40" s="11" t="inlineStr"><is><t>11. The Results by module table above updates automatically from the Status column.</t></is></c></row><row r="42"><c r="A42" s="3" t="inlineStr"><is><t>Black-box techniques used</t></is></c></row><row r="43"><c r="A43" s="4" t="inlineStr"><is><t>Equivalence Partitioning</t></is></c><c r="B43" s="8" t="inlineStr"><is><t>Inputs are grouped into valid and invalid classes, and one value from each class is tested.</t></is></c><c r="C43" s="12" t="n"></c><c r="D43" s="12" t="n"></c><c r="E43" s="12" t="n"></c><c r="F43" s="12" t="n"></c><c r="G43" s="13" t="n"></c></row><row r="44"><c r="A44" s="4" t="inlineStr"><is><t>Boundary Value Analysis</t></is></c><c r="B44" s="8" t="inlineStr"><is><t>Values at and just beyond a limit are tested, for example &#8369;0.99, &#8369;1.00 and &#8369;1.01 for a &#8369;1.00 minimum price.</t></is></c><c r="C44" s="12" t="n"></c><c r="D44" s="12" t="n"></c><c r="E44" s="12" t="n"></c><c r="F44" s="12" t="n"></c><c r="G44" s="13" t="n"></c></row><row r="45"><c r="A45" s="4" t="inlineStr"><is><t>Decision Table</t></is></c><c r="B45" s="8" t="inlineStr"><is><t>Combinations of conditions are tested, for example which vouchers can stack.</t></is></c><c r="C45" s="12" t="n"></c><c r="D45" s="12" t="n"></c><c r="E45" s="12" t="n"></c><c r="F45" s="12" t="n"></c><c r="G45" s="13" t="n"></c></row><row r="46"><c r="A46" s="4" t="inlineStr"><is><t>State Transition</t></is></c><c r="B46" s="8" t="inlineStr"><is><t>Changes in order or shipment status are tested, including transitions that must be blocked.</t></is></c><c r="C46" s="12" t="n"></c><c r="D46" s="12" t="n"></c><c r="E46" s="12" t="n"></c><c r="F46" s="12" t="n"></c><c r="G46" s="13" t="n"></c></row><row r="47"><c r="A47" s="4" t="inlineStr"><is><t>Use Case Testing</t></is></c><c r="B47" s="8" t="inlineStr"><is><t>A complete user flow is tested from start to finish with valid data.</t></is></c><c r="C47" s="12" t="n"></c><c r="D47" s="12" t="n"></c><c r="E47" s="12" t="n"></c><c r="F47" s="12" t="n"></c><c r="G47" s="13" t="n"></c></row><row r="48"><c r="A48" s="4" t="inlineStr"><is><t>Error Guessing</t></is></c><c r="B48" s="8" t="inlineStr"><is><t>Likely mistakes are tested based on experience, for example double-clicking Place Order or editing an ID in the URL.</t></is></c><c r="C48" s="12" t="n"></c><c r="D48" s="12" t="n"></c><c r="E48" s="12" t="n"></c><c r="F48" s="12" t="n"></c><c r="G48" s="13" t="n"></c></row></sheetData><mergeCells count="17"><mergeCell ref="A32:G32"/><mergeCell ref="A36:G36"/><mergeCell ref="B47:G47"/><mergeCell ref="B48:G48"/><mergeCell ref="A40:G40"/><mergeCell ref="B46:G46"/><mergeCell ref="A31:G31"/><mergeCell ref="A39:G39"/><mergeCell ref="A34:G34"/><mergeCell ref="A35:G35"/><mergeCell ref="B45:G45"/><mergeCell ref="A30:G30"/><mergeCell ref="A38:G38"/><mergeCell ref="B43:G43"/><mergeCell ref="B44:G44"/><mergeCell ref="A33:G33"/><mergeCell ref="A37:G37"/></mergeCells><pageMargins left="0.75" right="0.75" top="1" bottom="1" header="0.5" footer="0.5"/></worksheet>