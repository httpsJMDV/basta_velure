<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Pinned to the workbook rules so a demo .env cannot change what the tests assume: earnings are
             available when an order completes (A15), and delivered orders complete after 7 days (A11). -->
        <env name="PAYOUT_ESCROW_HOLD_DAYS" value="0" force="true"/>
        <env name="ORDER_AUTO_COMPLETE_DAYS" value="7" force="true"/>
        <server name="PAYOUT_ESCROW_HOLD_DAYS" value="0"/>
        <server name="ORDER_AUTO_COMPLETE_DAYS" value="7"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            The tests must never run against the dev database. A real environment variable (for example a
            leftover $env:DB_DATABASE) must not be able to change that. Laravel can read a value from
            $_SERVER as well as $_ENV, and <env> never touches $_SERVER, so the database is set in both
            places and <env> is forced.
        -->
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_DATABASE" value="velure_test" force="true"/>
        <server name="DB_CONNECTION" value="mysql"/>
        <server name="DB_DATABASE" value="velure_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
